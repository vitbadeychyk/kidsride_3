{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categories.html",
      "destination": "/catalog.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:slug",
      "destination": "/api/resolve-product?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:main_slug/:cat_slug/:product_slug",
      "destination": "/api/resolve-product?slug=:product_slug&main_slug=:main_slug&cat_slug=:cat_slug"
    },
    {
      "source": "/:main_slug/:cat_slug",
      "destination": "/api/resolve-category?main_slug=:main_slug&cat_slug=:cat_slug"
    },
    {
      "source": "/:main_slug",
      "destination": "/api/resolve-category?main_slug=:main_slug"
    }
  ],
  "headers": [
    {
      "source": "/product/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/ig-refresh",
      "schedule": "0 9 1 * *"
    }
  ]
}