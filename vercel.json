{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html",      "destination": "/",               "permanent": true },
    { "source": "/categories.html", "destination": "/catalog.html",   "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml",                "destination": "/api/sitemap" },
    { "source": "/product/:slug",              "destination": "/api/resolve-product?slug=:slug" },
    { "source": "/dityachi-dzhypy",            "destination": "/catalog.html?cat=jeep" },
    { "source": "/dityachi-kvadratsykly",      "destination": "/catalog.html?cat=quad" },
    { "source": "/dityachi-motosykly",         "destination": "/catalog.html?cat=moto" },
    { "source": "/dityachi-mashynky",          "destination": "/catalog.html?cat=car" },
    { "source": "/dityachi-traktory",          "destination": "/catalog.html?cat=tractor" },
    { "source": "/kataly-tolokary",            "destination": "/catalog.html?cat=walker" },
    { "source": "/dityachi-vantazhivky",       "destination": "/catalog.html?cat=truck" },
    { "source": "/dityachi-bahhi",             "destination": "/catalog.html?cat=buggy" },
    { "source": "/",                           "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/product/:slug",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/ig-refresh",
      "schedule": "0 9 1 * *"
    }
  ]
}
